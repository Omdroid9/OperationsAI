# SkyOS environment

All live providers are optional. The prototype runs on demo data without any keys.
A key present enables that provider. If the live call fails, the UI falls back to demo data.
Do not set DEMO_MODE to disable live providers; omit the key instead.

# Public FMCSA QCMobile web key
# FMCSA_WEB_KEY=
# FMCSA_API_KEY=

# Persistence (optional). When configured, workspace state syncs to Supabase on each mutation.
# Run supabase/schema.sql in your project SQL editor first.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# Auth (D0 staging). Anon key only — no service role required for D0.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SKYOS_AUTH_REQUIRED=false
# SKYOS_AUTH_REQUIRED=false
# SUPABASE_URL=                     # same as NEXT_PUBLIC_SUPABASE_URL (server SSR)
# SUPABASE_ANON_KEY=                # same as NEXT_PUBLIC_SUPABASE_ANON_KEY

# Public intake (D1). Service role server-only — never NEXT_PUBLIC_*.
# SUPABASE_SERVICE_ROLE_KEY=
# INTAKE_RATE_LIMIT_PER_HOUR=5
# INTAKE_HASH_SALT=
# TURNSTILE_SECRET_KEY=

# Live reads (D3). Live Mode loads normalized tables when true (default on with service role).
# SKYOS_SUPABASE_SOT=true

# Public marketing contact (optional — shown on About page and footer)
# NEXT_PUBLIC_SKYOS_CONTACT_EMAIL=hello@yourdomain.com
# NEXT_PUBLIC_SKYOS_CONTACT_PHONE=(555) 123-4567

# Production origin (Vercel). No trailing slash. Required for Dograh webhooks.
# NEXT_PUBLIC_APP_URL=https://YOUR-PROJECT.vercel.app

# Voice qualification — Dograh (outbound telephony workflow)
# Use a workflow with a telephony Start Call node (not API-trigger alone).
# DOGRAH_API_URL=https://app.dograh.com
# DOGRAH_API_KEY=
# DOGRAH_WORKFLOW_UUID=
# DOGRAH_WORKFLOW_ID=
# DOGRAH_WEBHOOK_SECRET=
# Server-only allowlist of consenting test numbers (comma-separated, digits or E.164). Never use NEXT_PUBLIC_*.
# DOGRAH_ALLOWED_TEST_NUMBERS=+15551234567

# Legacy Vapi keys (not used for Live Mode qualify in Phase 6)
# VAPI_API_KEY=
# VAPI_PHONE_NUMBER_ID=
# VAPI_SERVER_URL=
# NEXT_PUBLIC_APP_URL=https://YOUR-SUBDOMAIN.ngrok-free.app
# GLADIA_API_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Structured extraction (RegLens + documents + call summaries)
# GEMINI_API_KEY=

# FMCSA Company Census (Socrata) — optional app token if rate limits apply. Server-only.
# SOCRATA_APP_TOKEN=
